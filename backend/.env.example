PROJECT_NAME="Cultural & Venue Smart Copilot"
ENVIRONMENT="development"
LOG_LEVEL="DEBUG"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:80"

# Database & Redis
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/cultural_copilot"
REDIS_URL="redis://localhost:6379/0"

# Security & JWT
JWT_SECRET_KEY="super_secret_development_jwt_key_that_is_long_and_secure_64_bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Providers
OPENAI_API_KEY="sk-mock-openai-key-for-local-testing"
GEMINI_API_KEY="AIzaSy-mock-gemini-key-for-local-testing"
DEFAULT_AI_PROVIDER="gemini"
FALLBACK_AI_PROVIDER="openai"
